{
  "manifest_version": 3,
  "name": "Pi Bus Touch Controls",
  "version": "1.0.0",
  "description": "Keeps Pi Bus settings reachable from the Roon touchscreen display.",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "exclude_matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
    "js": ["touch-controls.js"],
    "run_at": "document_end"
  }]
}

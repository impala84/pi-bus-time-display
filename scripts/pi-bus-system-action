#!/usr/bin/env python3
"""Execute a tightly-scoped privileged request from the Pi Bus admin service."""
import json
import os
import re
import subprocess
from pathlib import Path

STATE = Path("/var/lib/pi-bus-time-display")
REQUEST = STATE / "system-action-request.json"
STATUS = STATE / "system-action-status"


def report(message: str) -> None:
    temporary = STATUS.with_suffix(".tmp")
    temporary.write_text(message + "\n", encoding="utf-8")
    os.chmod(temporary, 0o644)
    temporary.replace(STATUS)


def run(command: list[str]) -> None:
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    output = result.stdout.strip()
    if output:
        print(output, flush=True)
    if result.returncode:
        lines = [line.strip() for line in output.splitlines() if line.strip()]
        detail = lines[-1] if lines else f"exit status {result.returncode}"
        if "local changes" in output and "overwritten by merge" in output:
            detail = "local appliance changes blocked the update"
        raise RuntimeError(f"{Path(command[0]).name} failed: {detail}")


def roon_service() -> str:
    for name in ("roonbridge.service", "RoonBridge.service"):
        if subprocess.run(["systemctl", "cat", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return name
    raise RuntimeError("Roon Bridge service is not installed")


def display_power(powered: bool) -> None:
    devices = [item for item in sorted(Path("/sys/class/backlight").glob("*")) if (item / "bl_power").exists() or (item / "brightness").exists()]
    if not devices:
        raise RuntimeError("No display backlight control was found")
    saved_path = STATE / "backlight-brightness.json"
    try:
        saved = json.loads(saved_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        saved = {}
    for device in devices:
        power = device / "bl_power"
        brightness = device / "brightness"
        if powered:
            if power.exists():
                power.write_text("0", encoding="ascii")
            if brightness.exists():
                fallback = int((device / "max_brightness").read_text(encoding="ascii"))
                brightness.write_text(str(saved.get(device.name, fallback)), encoding="ascii")
        else:
            if brightness.exists():
                current = int(brightness.read_text(encoding="ascii"))
                if current > 0:
                    saved[device.name] = current
                brightness.write_text("0", encoding="ascii")
            if power.exists():
                power.write_text("4", encoding="ascii")
    if not powered:
        saved_path.write_text(json.dumps(saved), encoding="utf-8")
    vcgencmd = Path("/usr/bin/vcgencmd")
    if vcgencmd.exists():
        subprocess.run([str(vcgencmd), "display_power", "1" if powered else "0"], check=False)


def main() -> None:
    if not REQUEST.exists():
        return
    data = json.loads(REQUEST.read_text(encoding="utf-8"))
    REQUEST.unlink(missing_ok=True)
    action = data.get("action")
    report("Working…")
    if action == "update":
        run(["/usr/local/sbin/pi-bus-update"])
        report("Update installed. Reboot if requested.")
    elif action in {"display_on", "display_off"}:
        display_power(action == "display_on")
        report("Display awake." if action == "display_on" else "Display asleep.")
    elif action == "set_rotation":
        transform = str(data.get("transform", "normal"))
        if transform not in {"normal", "180"}:
            raise ValueError("Invalid display rotation")
        run(["/usr/local/sbin/pi-bus-appliance-mode", "rotate", transform])
        report("Display rotation updated.")
    elif action in {"roon_start", "roon_stop", "roon_restart"}:
        verb = action.removeprefix("roon_")
        run(["systemctl", verb, roon_service()])
        report(f"Roon Bridge {verb} complete.")
    elif action == "set_hostname":
        hostname = str(data.get("hostname", ""))
        if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", hostname):
            raise ValueError("Invalid device name")
        run(["hostnamectl", "set-hostname", hostname])
        report("Device name updated. Reboot recommended.")
    elif action == "set_wifi":
        ssid = str(data.get("ssid", ""))
        password = str(data.get("password", ""))
        if not ssid or len(ssid) > 32 or len(password) < 8:
            raise ValueError("Wi-Fi name or password is invalid")
        run(["nmcli", "device", "wifi", "connect", ssid, "password", password])
        report(f"Connected to {ssid}.")
    else:
        raise ValueError("Unknown system action")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        report(f"Failed: {error}")
        raise

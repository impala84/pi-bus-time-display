#!/usr/bin/env bash
set -euo pipefail

app_dir=/opt/pi-bus-time-display
user_file=/etc/pi-bus-time-display/display-user
service=/etc/systemd/system/pi-bus-native.service
transform_file=/etc/pi-bus-time-display/display-transform
input_rules=/etc/udev/rules.d/99-pi-bus-kiosk-input.rules

install_service() {
  local display_user=$1
  sed "s/@DISPLAY_USER@/${display_user}/g" "${app_dir}/systemd/pi-bus-native.service.in" >"${service}.tmp"
  install -m 0644 "${service}.tmp" "${service}"
  rm -f "${service}.tmp"
  systemctl daemon-reload
}

set_boot_rotation() {
  local transform=$1
  local cmdline=/boot/firmware/cmdline.txt
  [[ -f ${cmdline} ]] || cmdline=/boot/cmdline.txt
  if [[ ! -f ${cmdline} ]]; then
    echo "Could not find the Raspberry Pi kernel command line."
    exit 1
  fi
  [[ -f ${cmdline}.pi-bus-backup ]] || cp "${cmdline}" "${cmdline}.pi-bus-backup"
  local current
  current=$(<"${cmdline}")
  current=$(printf '%s\n' "${current}" | sed -E 's/(^|[[:space:]])video=DSI-[^[:space:]]+//g' | xargs)
  printf '%s video=DSI-1:800x480@60,rotate=%s\n' "${current}" "${transform/normal/0}" >"${cmdline}.tmp"
  install -m 0644 "${cmdline}.tmp" "${cmdline}"
  rm -f "${cmdline}.tmp"
}

configure_input() {
  local transform=$1
  {
    echo 'ACTION=="remove", GOTO="pi_bus_input_end"'
    case ${transform} in
      90) echo 'ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 -1 1 1 0 0"' ;;
      180) echo 'ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1"' ;;
      270) echo 'ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1"' ;;
      *) echo 'ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 1 0"' ;;
    esac
    echo 'LABEL="pi_bus_input_end"'
  } >"${input_rules}.tmp"
  install -m 0644 "${input_rules}.tmp" "${input_rules}"
  rm -f "${input_rules}.tmp"
  udevadm control --reload-rules
  udevadm trigger --subsystem-match=input
}

if [[ ${EUID} -ne 0 ]]; then
  echo "Run with sudo: sudo pi-bus-appliance-mode enable"
  exit 1
fi

case ${1:-} in
  enable)
    display_user=${SUDO_USER:-}
    if [[ -z ${display_user} || ${display_user} == root ]]; then
      [[ -f ${user_file} ]] && display_user=$(<"${user_file}")
    fi
    if [[ -z ${display_user} || ${display_user} == root ]] || ! id "${display_user}" >/dev/null 2>&1; then
      echo "Run this once with sudo from the Raspberry Pi desktop user."
      exit 1
    fi
    apt-get update
    apt-get install -y cage
    install -d -m 0755 /etc/pi-bus-time-display
    printf '%s\n' "${display_user}" >"${user_file}"
    [[ -f ${transform_file} ]] || printf '180\n' >"${transform_file}"
    set_boot_rotation "$(<"${transform_file}")"
    configure_input "$(<"${transform_file}")"
    install_service "${display_user}"
    systemctl enable pi-bus-native.service
    systemctl disable display-manager.service >/dev/null 2>&1 || true
    systemctl set-default multi-user.target
    echo "Appliance mode enabled. Reboot to start Pi Bus without the desktop."
    ;;
  disable)
    systemctl disable pi-bus-native.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target
    systemctl enable display-manager.service >/dev/null 2>&1 || true
    echo "Desktop mode restored. Reboot to apply it."
    ;;
  rotate)
    transform=${2:-}
    if [[ ! ${transform} =~ ^(normal|90|180|270)$ ]]; then
      echo "Rotation must be normal, 90, 180 or 270."
      exit 2
    fi
    printf '%s\n' "${transform}" >"${transform_file}"
    set_boot_rotation "${transform}"
    configure_input "${transform}"
    display_user=$(<"${user_file}")
    install_service "${display_user}"
    systemctl restart pi-bus-native.service
    echo "Display rotation set to ${transform}."
    ;;
  status)
    echo "Default boot: $(systemctl get-default)"
    systemctl is-enabled pi-bus-native.service 2>/dev/null || true
    ;;
  *)
    echo "Usage: sudo pi-bus-appliance-mode enable|disable|status|rotate <normal|90|180|270>"
    exit 2
    ;;
esac

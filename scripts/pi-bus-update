#!/usr/bin/env bash
set -euo pipefail

app_dir=/opt/pi-bus-time-display
status_file=/var/lib/pi-bus-time-display/update-status
dependency_stamp=/var/lib/pi-bus-time-display/roon-package-lock.sha256
update_stage="starting the update"

progress() {
  local message=$1
  local temporary="${status_file}.tmp"
  echo "${message}"
  printf '%s\n' "Update · ${message}" >"${temporary}"
  chmod 0644 "${temporary}"
  mv -f "${temporary}" "${status_file}"
}

fail_cleanly() {
  local code=$?
  if ((code != 0)); then
    printf '%s\n' "Failed: ${update_stage}. The updater stopped safely (exit ${code})." >"${status_file}.tmp"
    chmod 0644 "${status_file}.tmp"
    mv -f "${status_file}.tmp" "${status_file}"
  fi
  exit "${code}"
}

if [[ ${EUID} -ne 0 ]]; then
  echo "Run with sudo: sudo pi-bus-update"
  exit 1
fi
if [[ ! -d ${app_dir}/.git ]]; then
  echo "Pi Home is not a Git checkout in ${app_dir}."
  echo "Run the current install-pi.sh once to enable one-command updates."
  exit 1
fi

if [[ ${PI_HOME_UPDATE_LOCKED:-0} != 1 ]]; then
  exec 9>/run/lock/pi-home-update.lock
  if ! flock -n 9; then
    echo "A Pi Home update is already running."
    exit 0
  fi
  export PI_HOME_UPDATE_LOCKED=1
fi
trap fail_cleanly EXIT

update_stage="checking the installed version"
progress "Checking the installed version…"
if [[ -n $(git -c safe.directory="${app_dir}" -C "${app_dir}" status --porcelain) ]]; then
  backup_name="pi-bus-update backup $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  progress "Preserving local appliance changes…"
  git -c safe.directory="${app_dir}" -C "${app_dir}" stash push --include-untracked --message "${backup_name}"
fi
progress "Downloading the latest Pi Home release…"
update_stage="downloading the latest release"
timeout --signal=TERM --kill-after=10s 2m git -c safe.directory="${app_dir}" -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=30 -C "${app_dir}" fetch origin main
update_stage="switching to the downloaded release"
timeout --signal=TERM --kill-after=10s 1m git -c safe.directory="${app_dir}" -C "${app_dir}" checkout -B main origin/main

# Continue with the updater from the checkout we just fetched. This makes
# updater/install changes effective in this run instead of the next one.
if [[ ${PI_HOME_UPDATE_REEXECUTED:-0} != 1 ]]; then
  progress "Switching to the latest updater…"
  export PI_HOME_UPDATE_REEXECUTED=1
  exec /usr/bin/env bash "${app_dir}/scripts/pi-bus-update"
fi

required_packages=(python3-gi gir1.2-gtk-4.0 fonts-inter avahi-utils wlr-randr)
missing_packages=()
for package in "${required_packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "${package}" 2>/dev/null | grep -q '^install ok installed$'; then
    missing_packages+=("${package}")
  fi
done
if ((${#missing_packages[@]})); then
  update_stage="installing missing system components"
  progress "Installing missing system components…"
  timeout --signal=TERM --kill-after=15s 5m apt-get update
  timeout --signal=TERM --kill-after=15s 8m apt-get install -y "${missing_packages[@]}"
else
  progress "System components are already ready."
fi
install -d -o morningbus -g morningbus /var/lib/pi-bus-time-display/roon

progress "Installing Pi Home application files…"
update_stage="installing the Python application"
timeout --signal=TERM --kill-after=10s 3m "${app_dir}/.venv/bin/pip" install --disable-pip-version-check --no-deps "${app_dir}"
package_lock_hash=$(sha256sum "${app_dir}/roon-controller/package-lock.json" | cut -d' ' -f1)
installed_hash=$(cat "${dependency_stamp}" 2>/dev/null || true)
if [[ ! -d ${app_dir}/roon-controller/node_modules || ${installed_hash} != "${package_lock_hash}" ]]; then
  update_stage="installing Roon controller dependencies"
  progress "Installing updated Roon controller dependencies…"
  timeout --signal=TERM --kill-after=15s 5m npm --prefix "${app_dir}/roon-controller" ci --omit=dev --prefer-offline --no-audit --no-fund
  printf '%s\n' "${package_lock_hash}" >"${dependency_stamp}.tmp"
  chmod 0644 "${dependency_stamp}.tmp"
  mv -f "${dependency_stamp}.tmp" "${dependency_stamp}"
else
  progress "Roon controller dependencies are unchanged."
fi
update_stage="installing service definitions"
progress "Installing service definitions…"
install -m 0644 "${app_dir}/systemd/pi-bus-time-display.service" /etc/systemd/system/pi-bus-time-display.service
install -m 0644 "${app_dir}/systemd/pi-bus-roon-controller.service" /etc/systemd/system/pi-bus-roon-controller.service
install -m 0644 "${app_dir}/systemd/pi-bus-system-action.service" /etc/systemd/system/pi-bus-system-action.service
install -m 0644 "${app_dir}/systemd/pi-bus-system-action.path" /etc/systemd/system/pi-bus-system-action.path
install -m 0644 "${app_dir}/systemd/pi-home-leds.service" /etc/systemd/system/pi-home-leds.service
install -m 0755 "${app_dir}/scripts/pi-bus-update" /usr/local/sbin/pi-bus-update
install -m 0755 "${app_dir}/scripts/pi-bus-system-action" /usr/local/sbin/pi-bus-system-action
install -m 0755 "${app_dir}/scripts/pi-bus-appliance-mode" /usr/local/sbin/pi-bus-appliance-mode

if systemctl is-enabled --quiet pi-bus-native.service && [[ -f /etc/pi-bus-time-display/display-transform ]]; then
  progress "Applying the saved display configuration…"
  PI_HOME_NO_RESTART=1 /usr/local/sbin/pi-bus-appliance-mode rotate "$(</etc/pi-bus-time-display/display-transform)"
fi
chmod 0755 "${app_dir}/native-display/pi_bus_native.py"
chmod 0755 "${app_dir}/scripts/pi-bus-cage-launch"

desktop_user=${SUDO_USER:-}
if [[ -n ${desktop_user} && ${desktop_user} != root ]]; then
  desktop_home=$(getent passwd "${desktop_user}" | cut -d: -f6)
  install -d -o "${desktop_user}" -g "${desktop_user}" "${desktop_home}/.config/autostart"
  install -m 0644 -o "${desktop_user}" -g "${desktop_user}" "${app_dir}/native-display/pi-bus-native.desktop" "${desktop_home}/.config/autostart/pi-bus-native.desktop"
  rm -f "${desktop_home}/.config/autostart/pi-bus-time-display.desktop"
fi

progress "Restarting Pi Home services…"
update_stage="restarting Pi Home services"
systemctl daemon-reload
systemctl enable --now pi-bus-system-action.path
systemctl enable pi-home-leds.service
if ! systemctl restart pi-home-leds.service; then
  echo "Warning: the Pi status-light preference could not be applied; continuing the application update."
fi
systemctl restart pi-bus-time-display.service
systemctl enable --now pi-bus-roon-controller.service
systemctl restart pi-bus-roon-controller.service

wait_for_url() {
  local name=$1
  local url=$2
  local service=$3
  local attempt
  for attempt in {1..30}; do
    if python3 -c 'import sys, urllib.request; urllib.request.urlopen(sys.argv[1], timeout=1).read()' "${url}" >/dev/null 2>&1; then
      progress "${name} is ready."
      return 0
    fi
    sleep 1
  done
  echo "${name} did not become ready. Recent service log:"
  journalctl -u "${service}" -n 40 --no-pager
  return 1
}

progress "Waiting for the main display service…"
wait_for_url "Main display" "http://127.0.0.1:8765/api/status" "pi-bus-time-display.service"
progress "Waiting for the Roon controller…"
wait_for_url "Roon controller" "http://127.0.0.1:8766/api/state" "pi-bus-roon-controller.service"

if systemctl is-enabled --quiet pi-bus-native.service; then
  progress "Restarting the touchscreen…"
  systemctl restart pi-bus-native.service
fi

progress "Complete — all Pi Home services are responding."
printf '%s\n' "Update installed. Pi Home services restarted." >"${status_file}.tmp"
chmod 0644 "${status_file}.tmp"
mv -f "${status_file}.tmp" "${status_file}"
trap - EXIT

[Unit]
Description=Pi Bus native touchscreen appliance
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@DISPLAY_USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=GDK_BACKEND=wayland
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -s -- /opt/pi-bus-time-display/native-display/pi_bus_native.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
